# এই ফাইল কপি করে .env.local বানান (.env.local git এ যায় না)। Vercel এ একই নামে Environment Variables দিন।

# Supabase → Project Settings → API Keys (publishable key; পুরনো প্রজেক্টে anon key ও চলে)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# সাইটের ঠিকানা: Google থেকে ফেরার লিংক আর SMS এর কোড নিজে বসানোর (WebOTP) জন্য।
# local এ http://localhost:3000, Vercel এ সাইটের ঠিকানা
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- মোবাইল OTP এর SMS (শুধু server এ, কখনো NEXT_PUBLIC_ দিয়ে নয়) ----
# Supabase → Authentication → Hooks → Send SMS হুক খুললে যে secret দেয় (v1,whsec_... পুরোটা)
SEND_SMS_HOOK_SECRET=
# log (কিছু পাঠায় না, server log এ কোড লেখে) | smsnetbd | bulksmsbd
SMS_PROVIDER=log
SMS_API_KEY=
# gateway এ অনুমোদিত Sender ID (bulksmsbd তে লাগবেই, smsnetbd তে না দিলে তাদের ডিফল্ট)
SMS_SENDER_ID=

# ---- শুধু server এ (কখনো NEXT_PUBLIC_ দিয়ে নয়, কাউকে দেবেন না) ----
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)। লাগে আইডি দিয়ে লগইনে (আইডি থেকে নম্বর বের করা)
# আর সাইন আপ/লগইনে "এই নম্বরে অ্যাকাউন্ট আছে কি" দেখতে। না দিলে আইডি দিয়ে লগইন বন্ধ থাকে, মোবাইল নম্বর দিয়ে চলে
SUPABASE_SECRET_KEY=

# পরের ধাপে লাগবে
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_TOKEN_KEY=
# GEMINI_API_KEY=
